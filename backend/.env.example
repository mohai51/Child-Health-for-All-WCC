# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration (Atlas or local URI. Leave empty in development to use embedded in-memory MongoDB)
MONGODB_URI=

# Session / JWT Security
SESSION_SECRET=super_secret_session_key_min_32_characters_random_string_wcc_health
SESSION_EXPIRES_IN=8h

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGIN=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# Image Provider Configuration: 'imagesdb' or 'local_secure' (for private medical documents)
IMAGE_PROVIDER=local_secure
IMAGESDB_API_KEY=
IMAGESDB_API_BASE_URL=https://api.imagesdb.io/v1

# Upload limits
MAX_IMAGE_SIZE_MB=5
UPLOAD_TEMP_DIR=./uploads/temp
SECURE_STORAGE_DIR=./uploads/secure
